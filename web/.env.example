# Copy to .env.local for a local override. Both are build-time values, read by
# src/lib/site.ts, so they are safe to expose: nothing secret lives here.

# Canonical origin used in metadataBase, Open Graph URLs, JSON-LD and the
# sitemap. The committed default is the production domain, which is correct for
# the site of record. Set it to another host only for a staging image, and pair
# that with NOINDEX=true.
NEXT_PUBLIC_SITE_URL=https://engineering.catholic.edu

# "true" emits noindex meta, an X-Robots-Tag header and a robots.txt that
# disallows everything. Unset falls back to an origin test: anything that is not
# the production URL is refused. The Dockerfile defaults this to true, so a
# production deploy passes --build-arg NOINDEX=false on purpose.
NOINDEX=
